  (text "Battery pack -- 6S (Molicel INR-21700-P42A x6 series), REFERENCES.md [14]"
    (at 84.85 12.54 0)
    (effects (font (size 2.0 2.0)))
    (uuid 809b2017-c9fc-4737-871c-f36ae2d59024)
  )
  (text "No external TPM: message authentication is provided by the S32K144's own on-chip CSEc security module (internal peripheral, no dedicated pins) -- see ../README.md"
    (at 529.85 132.54 0)
    (effects (font (size 1.2 1.2)))
    (uuid 857b0dda-210f-497e-a0c7-fee642ec5067)
  )
  (text "nFAULT: pulled up only, not wired to MCU in this build -- open item, see ../README.md"
    (at 629.85 502.54 0)
    (effects (font (size 1.2 1.2)))
    (uuid 48a28b25-7930-485f-b9a2-23a207f93c7f)
  )
  (text "Faraday shield (WE-SHC 3671375 cover + 3670375 frame) over gate-drive / high-di/dt switching-node area -- see ../README.md EMI Hardening tier"
    (at 899.85 677.54 0)
    (effects (font (size 1.2 1.2)))
    (uuid 5e9bd90c-6af5-4348-a7ce-df8029788b0b)
  )
  (text "SOA/SOB/SOC (DRV8353S integrated per-phase CSA outputs) intentionally left unconnected: this build routes ADC_IU/IV/IW from external INA240 devices instead -- DRV8353S-vs-INA240 current-sense sourcing is an open design question, see ../README.md Open items."
    (at 719.85 707.54 0)
    (effects (font (size 1.2 1.2)))
    (uuid 9826515c-7bb0-4f34-821f-767a869a6786)
  )

