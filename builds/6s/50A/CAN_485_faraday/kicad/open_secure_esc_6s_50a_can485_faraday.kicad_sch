      (effects (font (size 1.27 1.27)))
    )
    (property "Note" "Package changed from a 10 mm radial THT can to 1210 SMD 2026-08-16 for the 30 x 70 mm envelope and double-sided assembly. ENGINEERING DEFAULT, not a selected part: capacitance/voltage/ESR are unchanged on paper but no 1210 part has been sourced, and a 1210 will hold far less bulk than the radial it replaces. The reference design [47] carries 470 uF 63 V EXTERNAL to the board for exactly this reason. Size the on-board bulk against the final layout and decide whether external bulk is required." (at 169.85 32.54 0)
      (effects (font (size 1.27 1.27)))
    )
    (pin "1" (uuid 47e2badb-4920-490c-8066-2fd471696036))
