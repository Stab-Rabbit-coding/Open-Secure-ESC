  (symbol (lib_id "Open_Secure_ESC_Generic:Conn_01x02") (at 219.85 212.54 0) (unit 1)
    (in_bom yes) (on_board yes) (dnp no)
    (uuid 14202687-74c3-4bef-a80a-af69c288c8bd)
    (property "Reference" "J2" (at 219.85 202.38 0)
      (effects (font (size 1.27 1.27)))
    )
    (property "Value" "J_CAN" (at 219.85 204.92 0)
      (effects (font (size 1.27 1.27)))
    )
    (property "Footprint" "Open_Secure_ESC:SolderPad_1x02_SMD_P2.54mm" (at 219.85 212.54 0)
      (effects (font (size 1.27 1.27)))
    )
    (property "Datasheet" "" (at 219.85 212.54 0)
      (effects (font (size 1.27 1.27)))
    )
    (property "Description" "" (at 219.85 212.54 0)
      (effects (font (size 1.27 1.27)))
    )
    (property "Note" "Through-hole pin header -> bare SMD solder pads 2026-08-16. On this double-sided 30x60 board a THT part blocks BOTH sides: 9 THT parts occupied 482 mm^2 but consumed 964 mm^2 of the 3600 mm^2 budget, which is what stopped the layout converging. Precedent: the S50 [47] specifies 'CAN Port Connector: Solder PAD' and carries no headers. TRADE, flagged per AGENTS.md Sec.4: no mechanical retention -- a soldered wire relies on the joint alone. Acceptable for J1 (debug). J2/J3 leave the board in service and need strain relief from a tie-down, potting, or a real connector chosen later. See TODO.md." (at 219.85 212.54 0)
      (effects (font (size 1.27 1.27)))
