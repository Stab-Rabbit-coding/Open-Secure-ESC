  (symbol (lib_id "MSPM0G3518_Q1_PM:MSPM0G3518_Q1_PM") (at 529.85 292.54 0) (unit 1)
    (in_bom yes) (on_board yes) (dnp no)
    (uuid 1a905a07-3245-4ddc-8119-b3b658c864bf)
    (property "Reference" "U1" (at 529.85 276.03 0)
      (effects (font (size 1.27 1.27)))
    )
    (property "Value" "MSPM0G3518_Q1_PM" (at 529.85 278.57 0)
      (effects (font (size 1.27 1.27)))
    )
    (property "Footprint" "Package_QFP:LQFP-64_10x10mm_P0.5mm" (at 529.85 292.54 0)
      (effects (font (size 1.27 1.27)))
    )
    (property "Datasheet" "docs/datasheets/mspm0g3518-q1.pdf" (at 529.85 292.54 0)
      (effects (font (size 1.27 1.27)))
    )
    (property "Description" "TI MSPM0G3518-Q1 Arm Cortex-M0+ MCU, PM (LQFP-64, 12x12mm) package, orderable M0G3518QPMRQ1 -- project MCU as of 2026-08-10, replacing the NXP S32K144 (REFERENCES.md [31], superseded). Swapped in for its AES-128/256 accelerator with GCM support plus a hardware keystore, which lifts the AES-128 ceiling the S32K144's SHE-compliant CSEc imposed (finding C-01 in docs/secure-element-architecture.md). The Infineon OPTIGA(TM) Trust M secure element (REFERENCES.md [45], schematic U2) is UNAFFECTED by this swap and remains required: the MSPM0's AES engine is symmetric-only, so the Trust M still provides asymmetric PKI device authentication (ECDSA over a fab-provisioned key + X.509 certificate) and ephemeral session-key agreement (ECDHE + KDF), while the MCU consumes the agreed session key for the per-frame authenticated hot path. See docs/secure-element-architecture.md for the full division of labour." (at 529.85 292.54 0)
      (effects (font (size 1.27 1.27)))
    )
    (property "Citation" "[44]" (at 529.85 292.54 0)
      (effects (font (size 1.27 1.27)))
    )
