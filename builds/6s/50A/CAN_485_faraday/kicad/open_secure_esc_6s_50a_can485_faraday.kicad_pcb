	(footprint "SolderPad_1x04_SMD_P1.27mm_Probe"
		(layer "B.Cu")
		(uuid "6b497271-33c3-4f91-ae8e-e89fa21a5ba3")
		(at 25 81)
		(descr "SMD PROBE-TARGET pad strip, 4 pads, 1.27 mm pitch, 0.9 x 1.8 mm pads -- a debug-probe landing pattern, NOT a wire-solder pad. For J1 (SWD) only: a bring-up/debug interface, not a flight connection, so it trades solder area for board area. 1.27 mm is the pitch standard pogo-pin debug jigs use, and the strip stays single-row so an off-the-shelf inline fixture fits. Pad geometry is an ENGINEERING DEFAULT (AGENTS.md Sec.4), not a datasheet or IPC value. Do NOT use for J2/J3, which leave the board in service -- see symbols/tools/gen_smd_solder_pad_footprints.py.")
